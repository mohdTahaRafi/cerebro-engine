# Production stack configuration (phase 6 §8, task 6.19). Copy to `.env` in this same
# directory — `docker compose -f docker-compose.prod.yml up` reads it automatically.
# This is separate from backend/.env (development, `npm run dev` outside Docker).

# The domain Caddy provisions a TLS certificate for and the frontend/backend are served
# from. Must be a real, publicly resolvable domain pointed at this host for Caddy's
# automatic ACME/Let's Encrypt issuance to succeed.
DOMAIN=cerebro.example.com

# Required — same provider keys as backend/.env.example.
COHERE_API_KEY=
LLAMA_CLOUD_API_KEY=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only read when LLM_PROVIDER=ollama. host.docker.internal reaches an Ollama instance
# running on the Docker host itself, outside this compose stack.
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2-vision:11b

# MinIO — generate real credentials for production; these are the S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY backend/src/providers/storage.js's S3 driver authenticates with.
MINIO_ROOT_USER=cerebro
MINIO_ROOT_PASSWORD=

# Visual (ColPali) retrieval. Off by default — it needs a GPU to be practical: on CPU a
# single page's embedding takes minutes, versus ~1.5s for the OCR path. Leaving it off
# keeps scanned PDFs fully searchable through their OCR text and still stores every page
# image for citation; what it gives up is matching on appearance — charts, diagrams,
# layout, stamps, handwriting. Set to true only alongside COLPALI_DEVICE=cuda on a GPU host.
COLPALI_ENABLED=false

LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=cerebro
LANGCHAIN_API_KEY=
LANGSMITH_ORG_ID=

# Phase 5 — same auth/mail/sms config as backend/.env.example (backend/src/config/index.js
# §9). SESSION_SECRET and PUBLIC_URL are required (≥32 chars for SESSION_SECRET); the
# provider credentials below are optional and merely absent from
# GET /api/auth/capabilities when unset. Not yet wired into this compose file's `backend`
# service `environment:` block — add entries there, sourced from these values, before
# relying on this stack for auth.
SESSION_SECRET=
# Should match https://<DOMAIN above>, e.g. https://cerebro.example.com.
PUBLIC_URL=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
