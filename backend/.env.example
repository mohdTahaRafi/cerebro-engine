PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/cerebro
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379
VISION_SERVICE_URL=http://localhost:8100

COHERE_API_KEY=
LLAMA_CLOUD_API_KEY=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2-vision:11b
# Only read when LLM_PROVIDER=groq. Hosted, free-tier, OpenAI-compatible (console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

STORAGE_DRIVER=filesystem
PAGE_STORAGE_DIR=./storage/pages
UPLOAD_STORAGE_DIR=./storage/uploads
# S3/MinIO — only read when STORAGE_DRIVER=s3 (Phase 6)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=cerebro
LANGCHAIN_API_KEY=
# Phase 6: powers the /advanced console's LangSmith deep link. Find it in the LangSmith
# URL after logging in (https://smith.langchain.com/o/<this value>/...). Optional — the
# console shows the run id without a link when unset.
LANGSMITH_ORG_ID=

# Phase 6: Redis-backed rate limiting (backend/src/api/middleware/rateLimit.js) uses the
# same REDIS_URL above; nothing additional to configure here.

# Phase 6: required in production (NODE_ENV=production) for the CORS allowlist — a
# comma-separated list of exact origins, e.g. https://cerebro.example.com. Development
# (NODE_ENV=development) falls back to permitting any localhost/127.0.0.1 origin so the
# Vite dev server needs no entry here.
CORS_ALLOWED_ORIGINS=

# Phase 5: session cookie signing key — must be at least 32 characters, or the backend
# exits at startup. Generate one with `openssl rand -base64 32`.
SESSION_SECRET=
# Phase 5: this backend's externally-reachable origin, e.g. https://cerebro.example.com.
# OAuth provider callback URLs (Google, GitHub) are built from it.
PUBLIC_URL=http://localhost:5000
# Phase 5: comma-separated email addresses seeded with role: 'admin' at signup. Optional —
# empty means no admin accounts are auto-provisioned.
ADMIN_EMAILS=

# Phase 5: Google OAuth. Optional — omitted, "Continue with Google" is absent from
# GET /api/auth/capabilities and the frontend hides the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Phase 5: GitHub OAuth. Optional — same capability-gating as Google above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Phase 5: outbound mail (signup verification, password reset OTP). Optional — omitted,
# 'email' is absent from the capabilities' OTP channel list.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Phase 5: Twilio SMS (password reset OTP over SMS). Optional — omitted, 'sms' is absent
# from the capabilities' OTP channel list.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Phase 8 §3.3: per-tenant resource quotas — a rate limit alone doesn't stop a user
# staying under it indefinitely and still filling the disk. Every value below is the
# config/index.js default; uncomment and change only to override it.
# MAX_DOCUMENTS_PER_CONTEXT=500
# MAX_CONTEXTS_PER_USER=50
# MAX_STORAGE_BYTES_PER_USER=5368709120
# MAX_CHUNKS_PER_USER=500000
