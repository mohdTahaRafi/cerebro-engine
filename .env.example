# Production stack configuration (phase 6 §8, task 6.19). Copy to `.env` in this same
# directory — `docker compose -f docker-compose.prod.yml up` reads it automatically.
# This is separate from backend/.env (development, `npm run dev` outside Docker).

# The domain Caddy provisions a TLS certificate for and the frontend/backend are served
# from. Must be a real, publicly resolvable domain pointed at this host for Caddy's
# automatic ACME/Let's Encrypt issuance to succeed.
DOMAIN=cerebro.example.com

# Required — same provider keys as backend/.env.example.
COHERE_API_KEY=
LLAMA_CLOUD_API_KEY=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only read when LLM_PROVIDER=ollama. host.docker.internal reaches an Ollama instance
# running on the Docker host itself, outside this compose stack.
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2-vision:11b
# Only read when LLM_PROVIDER=groq. Hosted, free-tier, OpenAI-compatible — no local model
# to install (get a key at console.groq.com). GROQ_MODEL defaults to a stable text model;
# see backend/src/providers/llm.js's VISION_MODEL_PATTERN comment before switching to a
# vision-capable (Preview) model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# MinIO — generate real credentials for production; these are the S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY backend/src/providers/storage.js's S3 driver authenticates with.
MINIO_ROOT_USER=cerebro
MINIO_ROOT_PASSWORD=

# Visual (ColPali) retrieval. Off by default — it needs a GPU to be practical: on CPU a
# single page's embedding takes minutes, versus ~1.5s for the OCR path. Leaving it off
# keeps scanned PDFs fully searchable through their OCR text and still stores every page
# image for citation; what it gives up is matching on appearance — charts, diagrams,
# layout, stamps, handwriting. Set to true only alongside COLPALI_DEVICE=cuda on a GPU host.
COLPALI_ENABLED=false

LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=cerebro
LANGCHAIN_API_KEY=
LANGSMITH_ORG_ID=

# ── Sessions & identity (Phase 5) ──────────────────────────────────────────
# Wired into docker-compose.prod.yml's `backend` service environment: block (phase 8
# §4.2/§4.3). SESSION_SECRET is required, ≥32 random chars: openssl rand -base64 48.
# There is no separate PUBLIC_URL entry here — docker-compose.prod.yml derives it as
# https://${DOMAIN} (the value at the top of this file), so it can never drift from the
# domain Caddy actually serves and the OAuth redirect_uri actually needs (Caddyfile's
# own comment on the www-host redirect explains why that mismatch is worth avoiding).
SESSION_SECRET=
ADMIN_EMAILS=              # comma-separated; these addresses get role=admin at signup
GOOGLE_CLIENT_ID=          # console.cloud.google.com → Credentials → OAuth client
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=          # github.com/settings/developers — needs the user:email scope
GITHUB_CLIENT_SECRET=
# ── OTP delivery (Phase 5) ─────────────────────────────────────────────────
SMTP_HOST=                 # leave blank to disable email OTP entirely
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                 # "Cerebro <no-reply@example.com>"
TWILIO_ACCOUNT_SID=        # leave blank to omit the SMS channel from the UI
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# ── Quotas (Phase 8 §3.3) ───────────────────────────────────────────────────
MAX_DOCUMENTS_PER_CONTEXT=500
MAX_CONTEXTS_PER_USER=50
MAX_STORAGE_BYTES_PER_USER=5368709120
MAX_CHUNKS_PER_USER=500000
